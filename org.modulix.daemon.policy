<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE policyconfig PUBLIC
    "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
    "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig-1.dtd">
<policyconfig>

  <vendor>ModulixOS Daemon</vendor>
  <vendor_url>https://example.com</vendor_url>

  <action id="org.modulix.daemon.install">
    <description>Install a system-wide package, module or module plugin</description>
    <description
            xml:lang="fr"
        >Installer un paquet, module ou plugin de module au niveau système</description>
    <message>Authentication is required to install system software.</message>
    <message
            xml:lang="fr"
        >Une authentification est requise pour installer un logiciel système.</message>

    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
  </action>

  <action id="org.modulix.daemon.remove">
    <description>Remove a system-wide package, module or module plugin</description>
    <description
            xml:lang="fr"
        >Supprimer un paquet, module ou plugin de module au niveau système</description>
    <message>Authentication is required to remove system software.</message>
    <message
            xml:lang="fr"
        >Une authentification est requise pour supprimer un logiciel système.</message>

    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
  </action>

  <action id="org.modulix.daemon.update">
    <description>Refresh system inputs and rebuild the system</description>
    <description
            xml:lang="fr"
        >Rafraîchir les entrées système et reconstruire le système</description>
    <message>Authentication is required to update the system.</message>
    <message
            xml:lang="fr"
        >Une authentification est requise pour mettre à jour le système.</message>

    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
  </action>

</policyconfig>
